{
  "version": "0.0.1",
  "//": "Порты вне 5150-5249 и 5050-5149: эти диапазоны Windows резервирует под Hyper-V/WSL (проверить: netsh interface ipv4 show excludedportrange protocol=tcp), и 5173/5199 там оказались — сокет не биндится вообще. Диапазоны плавают между перезагрузками, так что при ошибке «port is reserved by the OS» смотреть netsh, а не гадать.",
  "configurations": [
    {
      "name": "ai-incubator-safe",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:safe"
      ],
      "port": 5273
    },
    {
      "name": "ai-incubator",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5273
    },
    {
      "name": "ai-incubator-api-safe",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-api-safe.mjs"
      ],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "ai-incubator-api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.js"
      ],
      "port": 3001
    },
    {
      "name": "ai-incubator-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "exec",
        "--",
        "vite",
        "--port",
        "5299",
        "--strictPort"
      ],
      "port": 5299
    },
    {
      "name": "mcp-docs",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/mcp-docs.mjs"
      ],
      "port": 3011,
      "autoPort": true
    }
  ]
}

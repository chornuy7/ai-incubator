TELEGRAM_API_ID=38680490
TELEGRAM_API_HASH=your_api_hash
API_PORT=3001

# Опционально — генерация комментариев через OpenAI (иначе шаблоны)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# §10.2 Supabase — заполнить в локальном .env (НЕ коммитить реальные значения!)
# DATA_BACKEND=supabase
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...   # секрет — только локально

# §10.3 Приватный API «мозгов» — ОДИН сервисный ключ, живёт только здесь (не в БД,
# не в интерфейсе). Без него /api/v1 закрыт. Значение — любая длинная случайная
# строка (удобно с префиксом aii_live_sk_). Меняешь ключ — перезапусти процесс.
# MURMEX_API_KEY=aii_live_sk_<длинная_случайная_строка>
# Необязательно: действовать от имени конкретного пользователя продукта (его RBAC).
# Без этого ключ — системный, с полным доступом.
# MURMEX_API_KEY_OWNER=usr_...

# MCP-сервер (docs/mcp/MCP-SPEC.md §8).
# Канонический URI ресурса для обнаружения авторизации (RFC 9728). Без него адрес
# собирается из X-Forwarded-*; за прокси задать ЯВНО, иначе в документ метаданных
# попадёт внутренний адрес, недостижимый для клиента.
# PUBLIC_BASE_URL=https://myrmexgram.ai
# Дополнительные Origin, которым разрешён доступ к MCP-эндпоинту (защита от DNS
# rebinding). Через запятую; продовые домены и localhost уже разрешены по умолчанию.
# MCP_ALLOWED_ORIGINS=stage.myrmexgram.ai,preview.myrmexgram.ai
# OAuth-серверы для документа RFC 9728. Пока пусто — ключ выдаётся вне протокола,
# и документ честно НЕ обещает OAuth-поток, которого нет.
# MCP_AUTHORIZATION_SERVERS=https://auth.myrmexgram.ai
# Требовать заголовки Mcp-Method / Mcp-Name по букве спецификации. По умолчанию
# проверяется только их СОГЛАСОВАННОСТЬ с телом: клиентские SDK их пока не шлют.
# MCP_STRICT_HEADERS=1
# Живая документация MCP на /mcp-docs. Локально включена всегда; на проде (задан
# SESSION_SECRET) выключена, пока не поставить 1. MCP_DOCS=0 выключает где угодно.
# MCP_DOCS=1

# §2 Импорт аккаунтов с диска сервера. На проде (задан SESSION_SECRET) выключен:
# любой вошедший гулял бы по ФС сервера. Вернуть только для одиночного self-hosted.
# IMPORT_LOCAL_FS=1

# Учётка для входа в панель на деве. Реальные значения — только в локальном .env.
# На какой сервер уходят /api (локальный/боевой) — переключается в api.config.json.
# DEV_LOGIN_EMAIL=
# DEV_LOGIN_PASSWORD=

{
  "mcpServers": {
    "serena": {
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context",
        "ide-assistant",
        "--project",
        ".",
        "--transport",
        "stdio",
        "--enable-web-dashboard",
        "true"
      ]
    },
    "codebase-memory": {
      "command": "npx",
      "args": [
        "codebase-memory-mcp"
      ]
    }
  }
}
